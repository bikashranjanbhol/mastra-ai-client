# ─────────────────────────────────────────────────────────────────────────────
# Backend: mastra-ai-service (https://github.com/bikashranjanbhol/mastra-ai-service)
#
# Start the service with `npm run dev` in that repo; it serves the API at
# http://localhost:4111/api and Studio at http://localhost:4111.
# The client falls back to a built-in simulator when the service is unreachable,
# and says so in the header rather than failing silently.
# ─────────────────────────────────────────────────────────────────────────────

# Root of the Mastra HTTP API.
VITE_API_BASE_URL=http://localhost:4111/api

# Agent to chat with. The service registers agents under their id:
#   docs-agent    — answers from the documentation corpus, files tickets
#   triage-agent  — structured classification only, not conversational
VITE_AGENT_ID=docs-agent

# Mastra scopes memory by resource (the end user). Replace with the real
# session id once auth exists; today every browser shares this one.
VITE_RESOURCE_ID=demo-user

# Workflow registry key, from GET /api/workflows.
VITE_WORKFLOW_ID=triageAndFileWorkflow

# Timeout for non-streaming calls, in ms. Streaming calls are not capped.
VITE_API_TIMEOUT_MS=20000
